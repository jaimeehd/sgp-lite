#!/bin/sh
# Hook de SGP. Instalar:  cp tools/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Ejecuta el verificador (rápido, sin build) y el ratchet de pruebas.
# Cambio legítimo en pruebas existentes (aprobado por ti):  SGP_TESTS_APPROVED=1 git commit ...
ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT" || exit 1
if command -v python >/dev/null 2>&1; then PY=python; else PY=python3; fi
"$PY" tools/sgp_check.py || exit 1
"$PY" tools/sgp_check.py --ratchet || exit 1
# Guarda de sincronía de la política: solo existe en el repo del kit; en proyectos
# instalados el fichero no está y se omite sin más.
for t in kit/tools/test_policy_sync.py tools/test_policy_sync.py; do
    if [ -f "$t" ]; then "$PY" "$t" || exit 1; fi
done
