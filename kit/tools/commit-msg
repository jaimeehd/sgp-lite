#!/bin/sh
# Hook de SGP. Instalar:  cp tools/commit-msg .git/hooks/commit-msg && chmod +x .git/hooks/commit-msg
# Valida el mensaje (convención tipo[alcance]: asunto, un solo CHG-NNN), re-ejecuta las tres
# puertas (estructura, revisión, ratchet) y SELLA el resultado:  Gate: sgp_check ... | sgp_review ... | ratchet ...
# Los merge/revert/rebase se aceptan sin sellar. Falla cerrado: sin fichero no se valida nada.
[ -n "$1" ] || { echo "[ERROR] commit-msg: git no ha pasado el fichero del mensaje; sin mensaje no se valida nada."; exit 1; }
ROOT=$(git rev-parse --show-toplevel) || { echo "[ERROR] commit-msg: no se pudo determinar la raíz del repo."; exit 1; }
cd "$ROOT" || exit 1
if [ -f tools/sgp_check.py ]; then
    TOOLS=tools
elif [ -f kit/tools/sgp_check.py ]; then
    TOOLS=kit/tools     # repo del kit: los tools viven bajo kit/
else
    echo "[ERROR] commit-msg: no encuentro sgp_check.py (ni en tools/ ni en kit/tools/)."; exit 1
fi
if command -v python >/dev/null 2>&1; then PY=python; else PY=python3; fi
"$PY" "$TOOLS/sgp_check.py" --commit-msg "$1" || exit 1
exit 0
